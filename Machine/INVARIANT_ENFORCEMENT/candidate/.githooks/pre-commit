#!/bin/sh
set -eu
PYTHONDONTWRITEBYTECODE=1 exec python3 -c '
import subprocess, sys
try:
    path = "scripts/check_workflow_invariant.py"
    code = subprocess.check_output(["git", "show", ":" + path])
    if not code.strip():
        raise ValueError("staged validator is empty")
    sys.argv = [path, "--staged"]
    exec(compile(code, path, "exec"), {"__name__": "__main__"})
except (OSError, ValueError, subprocess.SubprocessError) as error:
    print("MACHINE_AUTOMATED_EXECUTION_REQUIRED: COMMIT BLOCKED: " + str(error), file=sys.stderr)
    sys.exit(3)
'
